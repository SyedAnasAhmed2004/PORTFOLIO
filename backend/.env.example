APP_NAME="Portfolio API"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (local) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=Portfolio
DB_ECHO=false

# --- PostgreSQL (hosted, e.g. Neon/Supabase on Vercel) ---
# When set, this overrides all DB_* values above.
DATABASE_URL=

# --- Contact form email via https://resend.com (optional; messages are always saved to the DB) ---
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=
